<script>
function updateSelectedCount() {
    const count = document.querySelectorAll('.audio-check:checked').length;
    const el = document.getElementById('selectedCount');
    if (el) {
        el.textContent = String(count);
    }
}

function selectAllAudio() {
    document.querySelectorAll('.audio-check').forEach(cb => cb.checked = true);
    updateSelectedCount();
}

function clearAudioSelection() {
    document.querySelectorAll('.audio-check').forEach(cb => cb.checked = false);
    updateSelectedCount();
}

function confirmDeleteSelected() {
    const count = document.querySelectorAll('.audio-check:checked').length;

    if (count <= 0) {
        alert('Please select audio files first.');
        return false;
    }

    return confirm('Delete ' + count + ' selected audio file(s)?');
}

function deleteOne(relativePath) {
    if (!confirm('Delete this audio file?')) {
        return;
    }

    document.getElementById('deleteOneFile').value = relativePath;
    document.getElementById('deleteOneForm').submit();
}

function playCard(button, url) {
    const card = button.closest('[data-card]');
    if (!card) {
        return;
    }

    const audio = card.querySelector('audio');
    if (!audio) {
        return;
    }

    document.querySelectorAll('[data-card]').forEach(other => {
        if (other !== card) {
            other.classList.remove('playing');
            const otherAudio = other.querySelector('audio');
            if (otherAudio) {
                otherAudio.pause();
            }
        }
    });

    if (audio.getAttribute('src') !== url) {
        audio.setAttribute('src', url);
    }

    card.classList.add('playing');

    audio.play().catch(err => {
        console.warn('Audio playback failed:', err);
    });
}

updateSelectedCount();
</script>
</body>
</html>
