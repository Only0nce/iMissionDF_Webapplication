function h(string $s): string
{
    return htmlspecialchars($s, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');
}

function normalize_path(string $path): string
{
    return str_replace('\\', '/', $path);
}

function human_size(int $bytes): string
{
    $units = ['B', 'KB', 'MB', 'GB', 'TB'];
    $size = (float)$bytes;
    $i = 0;

    while ($size >= 1024 && $i < count($units) - 1) {
        $size /= 1024;
        $i++;
    }

    return $i === 0
        ? sprintf('%d B', (int)$size)
        : sprintf('%.1f %s', $size, $units[$i]);
}

function safe_audio_realpath(?string $audioRoot, string $relative): ?string
{
    if ($audioRoot === false || $audioRoot === null) {
        return null;
    }

    $relative = ltrim(normalize_path($relative), '/');
    if ($relative === '' || str_contains($relative, '..')) {
        return null;
    }

    $full = realpath($audioRoot . '/' . $relative);
    if ($full === false) {
        return null;
    }

    $rootNorm = rtrim(normalize_path($audioRoot), '/') . '/';
    $fullNorm = normalize_path($full);

    if (!str_starts_with($fullNorm, $rootNorm)) {
        return null;
    }

    return $full;
}

function rel_url(string $relativePath): string
{
    $parts = explode('/', normalize_path($relativePath));
    $parts = array_map('rawurlencode', $parts);
    return implode('/', $parts);
}

function parse_audio_meta(string $relativePath, string $filename, int $mtime): array
{
    $pathParts = explode('/', normalize_path($relativePath));
    $folder = count($pathParts) > 1 ? $pathParts[0] : 'Root';

    $meta = [
        'folder' => $folder,
        'channel' => $folder,
        'frequency' => '',
        'dateKey' => '',
        'dateLabel' => date('Y-m-d', $mtime),
        'monthLabel' => date('Y-m', $mtime),
        'yearLabel' => date('Y', $mtime),
        'timeLabel' => date('H:i:s', $mtime),
        'displayName' => $filename,
        'sortTimestamp' => $mtime,
    ];

    /*
     * Supported filename pattern:
     *   41-44_19700101_082819_011344_121.100.wav
     */
    if (preg_match('/^(.+?)_(\d{8})_(\d{6})_(\d+)_([0-9]+(?:\.[0-9]+)?)\.[^.]+$/i', $filename, $m)) {
        $channel = $m[1];
        $dateKey = $m[2];
        $timeKey = $m[3];
        $freq = $m[5];

        $year = substr($dateKey, 0, 4);
        $month = substr($dateKey, 4, 2);
        $day = substr($dateKey, 6, 2);

        $hh = substr($timeKey, 0, 2);
        $mm = substr($timeKey, 2, 2);
        $ss = substr($timeKey, 4, 2);

        $parsedTs = strtotime("$year-$month-$day $hh:$mm:$ss");

        $meta['channel'] = $channel;
        $meta['frequency'] = $freq . ' MHz';
        $meta['dateKey'] = $dateKey;
        $meta['dateLabel'] = "$year-$month-$day";
        $meta['monthLabel'] = "$year-$month";
        $meta['yearLabel'] = $year;
        $meta['timeLabel'] = "$hh:$mm:$ss";
        $meta['displayName'] = $freq . ' MHz';

        /*
         * If device timestamp is valid enough, use it. Otherwise keep mtime.
         * This prevents obviously stale 1970 names from forcing all files old
         * when Apache/file mtime carries the real recent order.
         */
        if ($parsedTs !== false && (int)$year >= 2000) {
            $meta['sortTimestamp'] = $parsedTs;
        }

        return $meta;
    }

    foreach ($pathParts as $part) {
        if (preg_match('/^\d{8}$/', $part)) {
            $year = substr($part, 0, 4);
            $month = substr($part, 4, 2);
            $day = substr($part, 6, 2);

            $meta['dateKey'] = $part;
            $meta['dateLabel'] = "$year-$month-$day";
            $meta['monthLabel'] = "$year-$month";
            $meta['yearLabel'] = $year;
            break;
        }
    }

    if (preg_match('/([0-9]+(?:\.[0-9]+)?)\.(wav|mp3|ogg|flac|m4a)$/i', $filename, $m)) {
        $meta['frequency'] = $m[1] . ' MHz';
        $meta['displayName'] = $meta['frequency'];
    }

    return $meta;
}

function collect_audio_files(?string $audioRoot, string $audioUrlBase, array $allowedExt): array
{
    $items = [];

    if ($audioRoot === false || $audioRoot === null || !is_dir($audioRoot)) {
        return $items;
    }

    $iterator = new RecursiveIteratorIterator(
        new RecursiveDirectoryIterator($audioRoot, FilesystemIterator::SKIP_DOTS),
        RecursiveIteratorIterator::LEAVES_ONLY
    );

    foreach ($iterator as $fileInfo) {
        if (!$fileInfo->isFile()) {
            continue;
        }

        $ext = strtolower($fileInfo->getExtension());
        if (!isset($allowedExt[$ext])) {
            continue;
        }

        $full = $fileInfo->getRealPath();
        if ($full === false) {
            continue;
        }

        $rootNorm = rtrim(normalize_path($audioRoot), '/') . '/';
        $fullNorm = normalize_path($full);

        if (!str_starts_with($fullNorm, $rootNorm)) {
            continue;
        }

        $relative = substr($fullNorm, strlen($rootNorm));
        $filename = $fileInfo->getFilename();
        $mtime = $fileInfo->getMTime();
        $meta = parse_audio_meta($relative, $filename, $mtime);

        $items[] = [
            'name' => $filename,
            'relative' => $relative,
            'url' => $audioUrlBase . '/' . rel_url($relative),
            'sizeBytes' => $fileInfo->getSize(),
            'sizeLabel' => human_size($fileInfo->getSize()),
            'mtime' => $mtime,
            'mtimeLabel' => date('Y-m-d H:i:s', $mtime),
            'folder' => $meta['folder'],
            'channel' => $meta['channel'],
            'frequency' => $meta['frequency'],
            'dateKey' => $meta['dateKey'],
            'dateLabel' => $meta['dateLabel'],
            'monthLabel' => $meta['monthLabel'],
            'yearLabel' => $meta['yearLabel'],
            'timeLabel' => $meta['timeLabel'],
            'displayName' => $meta['displayName'],
            'sortTimestamp' => $meta['sortTimestamp'],
        ];
    }

    return $items;
}

function csrf_token(): string
{
    if (empty($_SESSION['audio_csrf'])) {
        $_SESSION['audio_csrf'] = bin2hex(random_bytes(16));
    }

    return $_SESSION['audio_csrf'];
}

function verify_csrf(): bool
{
    return isset($_POST['csrf'], $_SESSION['audio_csrf'])
        && hash_equals($_SESSION['audio_csrf'], (string)$_POST['csrf']);
}

$flash = '';
$flashType = 'info';

if ($_SERVER['REQUEST_METHOD'] === 'POST') {
    if (!verify_csrf()) {
        $flash = 'Invalid request token.';
        $flashType = 'danger';
    } else {
        $action = (string)($_POST['action'] ?? '');

        if ($action === 'delete_one') {
            $target = (string)($_POST['file'] ?? '');
            $real = safe_audio_realpath($audioRoot, $target);

            if ($real !== null && is_file($real)) {
                unlink($real);
                $flash = 'Deleted 1 audio file.';
                $flashType = 'success';
            } else {
                $flash = 'File not found or unsafe path.';
                $flashType = 'danger';
            }
        }

        if ($action === 'delete_selected') {
            $files = $_POST['files'] ?? [];
            if (!is_array($files)) {
                $files = [];
            }

            $deleted = 0;

            foreach ($files as $relative) {
                $real = safe_audio_realpath($audioRoot, (string)$relative);
                if ($real !== null && is_file($real)) {
                    unlink($real);
                    $deleted++;
                }
            }

            $flash = 'Deleted ' . $deleted . ' selected audio file(s).';
            $flashType = $deleted > 0 ? 'success' : 'danger';
        }
    }
}

$q = trim((string)($_GET['q'] ?? ''));
$date = trim((string)($_GET['date'] ?? ''));
$month = trim((string)($_GET['month'] ?? ''));
$year = trim((string)($_GET['year'] ?? ''));
$page = max(1, (int)($_GET['page'] ?? 1));
$perPage = (int)($_GET['per_page'] ?? $defaultPerPage);
if (!in_array($perPage, $perPageOptions, true)) {
    $perPage = $defaultPerPage;
}

$allItems = collect_audio_files($audioRoot, $audioUrlBase, $allowedExt);

$years = [];
foreach ($allItems as $item) {
    if ($item['yearLabel'] !== '') {
        $years[$item['yearLabel']] = true;
    }
}
$years = array_keys($years);
rsort($years, SORT_NATURAL);

$filtered = array_values(array_filter($allItems, static function (array $item) use ($q, $date, $month, $year): bool {
    if ($q !== '') {
        $hay = strtolower(implode(' ', [
            $item['name'],
            $item['relative'],
            $item['folder'],
            $item['channel'],
            $item['frequency'],
            $item['dateLabel'],
            $item['timeLabel'],
        ]));

        if (!str_contains($hay, strtolower($q))) {
            return false;
        }
    }

    if ($date !== '' && $item['dateLabel'] !== $date) {
        return false;
    }

    if ($month !== '' && $item['monthLabel'] !== $month) {
        return false;
    }

    if ($year !== '' && $item['yearLabel'] !== $year) {
        return false;
    }

    return true;
}));

/*
 * Always show latest first.
 */
usort($filtered, static function (array $a, array $b): int {
    $cmp = $b['sortTimestamp'] <=> $a['sortTimestamp'];
    if ($cmp !== 0) {
        return $cmp;
    }

    $cmp = $b['mtime'] <=> $a['mtime'];
    if ($cmp !== 0) {
        return $cmp;
    }

    return strnatcasecmp($a['name'], $b['name']);
});

$total = count($filtered);
$totalPages = max(1, (int)ceil($total / $perPage));
$page = min($page, $totalPages);
$offset = ($page - 1) * $perPage;
$pageItems = array_slice($filtered, $offset, $perPage);

function page_url(int $page): string
{
    $params = $_GET;
    $params['page'] = $page;
    return '?' . http_build_query($params);
}

